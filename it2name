#!/usr/bin/env bash
set -e

VERSION="0.2.4"

# Defaults
FG="white"
BG="black"
TEXT=""

show_version() {
  echo "it2name version $VERSION"
  exit 0
}

show_help() {
  cat <<EOF
it2name - iTerm2 caption renderer and tab name setter

Usage: it2name [OPTIONS] TEXT

Arguments:
  TEXT                    Text to render (use "." for current directory name)

Options:
  --fgcolor COLOR        Set foreground/text color (default: white)
  --bgcolor COLOR        Set background color (default: black)
  --version              Show version information
  --help                 Show this help message

Examples:
  it2name "Hello World"
  it2name .
  it2name --fgcolor red --bgcolor black "Production"

Colors: Any ImageMagick-supported color name (red, blue, green, yellow, etc.)
EOF
  exit 0
}

# Parse args
while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)
      show_version
      ;;
    --help|-h)
      show_help
      ;;
    --fgcolor)
      FG="$2"
      shift 2
      ;;
    --bgcolor)
      BG="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      TEXT="$1"
      shift
      ;;
  esac
done

if [[ -z "$TEXT" ]]; then
  echo "Error: TEXT argument is required" >&2
  echo "Usage: it2name [--fgcolor COLOR] [--bgcolor COLOR] TEXT" >&2
  echo "Try 'it2name --help' for more information." >&2
  exit 1
fi

# If the TEXT is just . then we want just show the folder name
if [[ "$TEXT" == "." ]]; then
  TEXT="$(basename "$PWD")"
fi

# Check if we're in a git repository and on a non-main branch
if git rev-parse --git-dir >/dev/null 2>&1; then
  BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  if [[ -n "$BRANCH" && "$BRANCH" != "main" ]]; then
    TEXT="$TEXT [$BRANCH]"
  fi
fi

# Detect terminal size using stty (most reliable in subshells)
if read ROWS COLS < <(stty size </dev/tty 2>/dev/null); then
  : # success
else
  COLS=${COLUMNS:-120}
  ROWS=${LINES:-40}
fi

# Calculate image dimensions based on terminal size. Render at 3x so the
# image stays crisp when iTerm2 scales it up to full window width on Retina.
IMG_W=$((COLS * 30))
IMG_H=$((ROWS * 60))

# imagemagick-full is keg-only; look up its prefix instead of assuming a fixed
# path (differs across Apple Silicon, Intel, and Linuxbrew installs), falling
# back to whatever "magick" is on PATH.
MAGICK_BIN="magick"
if command -v brew >/dev/null 2>&1; then
  FULL_PREFIX="$(brew --prefix imagemagick-full 2>/dev/null)"
  if [[ -n "$FULL_PREFIX" && -x "$FULL_PREFIX/bin/magick" ]]; then
    MAGICK_BIN="$FULL_PREFIX/bin/magick"
  fi
fi

# Render the caption on a large canvas and trim to the text's bounding box.
render_caption() {
  "$MAGICK_BIN" \
    -background "$BG" \
    -fill "$FG" \
    -font Helvetica-Bold \
    -gravity center \
    -size "${IMG_W}x${IMG_H}" \
    caption:"$TEXT" \
    -trim +repage \
    png:-
}

if [[ "$TERM_PROGRAM" == "iTerm.app" ]]; then
  # iTerm2's inline-image protocol scales to the window itself (width=100%,
  # aspect preserved), which is the only reliable way to fill the terminal:
  # chafa's image-mode output is stuck at the PNG's native pixel size.
  printf '\e]1337;File=inline=1;width=100%%;preserveAspectRatio=1:%s\a\n' \
    "$(render_caption | base64 | tr -d '\n')"
else
  render_caption \
  | chafa --symbols block --colors full --center on --scale max --size "${COLS}x${ROWS}"
fi

# Set iTerm2 session/tab name
printf '\e]1;%s\a' "$TEXT"
# echo out the pwd to stdout
pwd

